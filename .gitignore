# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data and generated streams
data/

# Asset bytes never enter git — they live on the release the manifest's `release`
# points at, and `fontaine assets fetch` verifies them by checksum on the way in.
# assets/manifest.yaml is deliberately not ignored: it is the pin.
assets/fonts/*
!assets/fonts/.gitkeep
assets/backgrounds/*
!assets/backgrounds/.gitkeep

# Presentation decks
.data/
